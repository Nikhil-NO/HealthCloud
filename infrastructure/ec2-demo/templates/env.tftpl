# Rendered by Terraform → stored as an SSM SecureString → written to /opt/healthcloud/.env on the box.
# docker compose reads this for image interpolation AND passes it into the containers via env_file.
# NOTE: this file contains secrets at apply time — it lives only in (encrypted) SSM + Terraform state,
# never in the repo. Do not echo it into logs.

# --- images (compose interpolation) ---
BACKEND_IMAGE=${backend_image}
FRONTEND_IMAGE=${frontend_image}

# --- Caddy (custom domain + ACME) ---
DOMAIN=${domain_name}
APEX_DOMAIN=${apex_domain}
ACME_EMAIL=${acme_email}

# --- Postgres container ---
POSTGRES_DB=healthcloud
POSTGRES_USER=${db_user}
POSTGRES_PASSWORD=${db_password}

# --- backend: datasource + app config ---
HEALTHCLOUD_DB_USER=${db_user}
HEALTHCLOUD_DB_PASSWORD=${db_password}
HEALTHCLOUD_AUDIT_HMAC_SECRET=${audit_hmac}

# demo,cognito: synthetic seed so Cognito logins map to real AppUsers, and Cognito is the ONLY login
# path (no `local` profile → no dev-login bypass on the public box).
SPRING_PROFILES_ACTIVE=demo,cognito

# No Kafka/MSK on this box — keep the relay + consumers off.
HEALTHCLOUD_OUTBOX_RELAY_ENABLED=false
HEALTHCLOUD_KAFKA_CONSUMERS_ENABLED=false

# --- Cognito OIDC (real login) ---
COGNITO_CLIENT_ID=${cognito_client_id}
COGNITO_CLIENT_SECRET=${cognito_client_secret}
COGNITO_ISSUER_URI=${cognito_issuer_uri}
COGNITO_HOSTED_UI_DOMAIN=${cognito_hosted_ui}
COGNITO_LOGOUT_REDIRECT_URI=${logout_uri}

# Honor X-Forwarded-* from Caddy so Spring sees the external https host.
SERVER_FORWARD_HEADERS_STRATEGY=framework
# Pin the OIDC callback to the fixed HTTPS domain. Caddy terminates TLS and proxies HTTP to nginx→
# backend, so Spring's {baseUrl} would otherwise compute an http:// redirect_uri Cognito rejects
# (the same lesson as CloudFront→ALB on the ECS stack). This relaxed-binding env overrides the yml.
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_COGNITO_REDIRECTURI=${redirect_uri}
